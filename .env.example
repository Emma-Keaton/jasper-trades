# .env - Environment Configuration for Jasper Trades
# Copy this to .env and fill in your API keys

# ===========================================
# NVIDIA NIM API (Required for AI features)
# ===========================================
# Get your key from: https://build.nvidia.com/
# Used for: AI trading signals, market analysis, chat assistant
# Recommended FREE tier models (updated 2026-06):
#   FAST: meta/llama-3.2-3b-instruct (for execution, risk checks)
#   BALANCED: meta/llama-3.1-8b-instruct (for copy trading)
#   SMART: meta/llama-3.1-70b-instruct (for analysis, news, sentiment)
#   DEEP: meta/llama-3.3-70b-instruct (for portfolio analysis)
#   ALTERNATIVE: mistralai/mixtral-8x7b-instruct-v0.1 (for ensemble)
NVIDIA_API_KEY=

# ===========================================
#  Trading (Stocks/Options execution)
# ===========================================
# Get keys from: https://.markets/
# Used for: US stock/options paper and live trading
_API_KEY=
_API_SECRET=
_PAPER=true  # Set to false for live trading

# ===========================================
# Binance (Crypto trading)
# ===========================================
# Get keys from: https://binance.com/my/settings/api-management
# Used for: Crypto spot and futures trading
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ===========================================
# cTrader OpenAPI (OAuth 2.0 Copy Trading)
# ===========================================
# Multi-tenant copy-trading with OAuth 2.0
# Users connect brokers securely via cTrader OAuth
# NO password storage - users authenticate on cTrader's site

# STEP 1: Register your application at https://connect.spotware.com/
# - Login with your cTrader account
# - Go to "My Applications" → "Create New Application"
# - Choose application type: "Web Application"
# - Set redirect URI: http://localhost:8000/api/v1/brokers/ctrader/callback (for local dev)
#   For production: https://your-app.onrender.com/api/v1/brokers/ctrader/callback
# - After registration, you'll get Client ID and Client Secret

CTRADER_CLIENT_ID=              # Paste your Client ID from cTrader Connect
CTRADER_CLIENT_SECRET=          # Paste your Client Secret from cTrader Connect

# Redirect URI - MUST match exactly what you registered in cTrader Connect
# For local development:
CTRADER_REDIRECT_URI=http://localhost:8000/api/v1/brokers/ctrader/callback
# For production (Render deployment), change to:
# CTRADER_REDIRECT_URI=https://jasper-trades.onrender.com/api/v1/brokers/ctrader/callback

# Environment: true = Sandbox/Demo, false = Live Production
# Start with sandbox to test, then set to false for real money trading
CTRADER_SANDBOX=true  # CHANGE TO false for live production trading

# STEP 2: Generate encryption key for token storage
# Run this Python command to generate a secure key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Example output: abc123xyz... (44 characters)
# Store this securely - if you lose it, all stored tokens become invalid!
# DO NOT commit this to git - add .env to .gitignore
CTRADER_ENCRYPTION_KEY=         # Paste your generated Fernet key here

# cTrader Service Configuration
CTRADER_BROKER_ENABLED=true     # Enable cTrader broker service
CTRADER_RATE_LIMIT=50           # API requests per second (cTrader limit: 50-100)

# ===========================================
# Solana/DeFi Trading (Optional)
# ===========================================
# Get RPC URL from: https://www.quicknode.com/ or https://solana.com/rpc
# Used for: Solana token trading, DeFi protocols
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_ENABLED=false

# ===========================================
# Security Keys (CRITICAL - Generate these!)
# ===========================================
# Generate SECRET_KEY with: openssl rand -hex 32
# Used for: JWT token signing, session encryption
SECRET_KEY=                     # 64-character hex string

# Generate API_AUTH_KEY with: openssl rand -hex 16
# Used for: API authentication (legacy support)
API_AUTH_KEY=                   # 32-character hex string

# cTrader Token Encryption
# The CTRADER_ENCRYPTION_KEY above uses Fernet (AES-128 symmetric encryption)
# All OAuth tokens are encrypted before storing in database
# Tokens are ONLY decrypted in memory during trade execution

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed frontend origins
# For local development:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# For production (Vercel deployment):
# CORS_ORIGINS=https://jasper-trades.vercel.app,https://jasper-trades.onrender.com

# ===========================================
# Database Configuration
# ===========================================
# SQLite (default - works for local dev and small production)
DATABASE_URL=sqlite+aiosqlite:///./data/sqlite/jasper_trades.db

# For PostgreSQL (production with many users):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/jasper_trades

# ===========================================
# Deployment Settings
# ===========================================
# Application name and version
APP_NAME=Jasper Trades
APP_VERSION=2.0.0

# Debug mode (set to false in production!)
DEBUG=false

# Server port (for Docker/Render deployment)
PORT=8080

# ===========================================
# Kronos AI Model (4GB RAM optimized)
# ===========================================
# AI/ML model configuration for market predictions
KRONOS_MODEL=kronos-mini
KRONOS_FORECAST_HORIZON=50
KRONOS_BATCH_SIZE=3
KRONOS_MEMORY_THRESHOLD=85.0

# ===========================================
# Logging Configuration
# ===========================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text

# ===========================================
# Telegram Notifications (Recommended)
# ===========================================
# Get bot token from @BotFather on Telegram
# Chat ID: Start a chat with your bot, send /start, then visit:
#   https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
# Look for "chat":{"id":123456789} in the response
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# ===========================================
# Quick Start Guide
# ===========================================
# 1. Copy this file: cp .env.example .env
# 2. Generate SECRET_KEY: openssl rand -hex 32
# 3. Generate CTRADER_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 4. Register cTrader app at https://connect.spotware.com/ and get CLIENT_ID + CLIENT_SECRET
# 5. Set CTRADER_REDIRECT_URI to match your registered callback URL
# 6. For production: Set CTRADER_SANDBOX=false
# 7. Run the app: cd backend && python -m uvicorn app.main:app --reload

# ===========================================
# Production Checklist (Render/Vercel)
# ===========================================
# ✓ Set CTRADER_SANDBOX=false for live trading
# ✓ Update CTRADER_REDIRECT_URI to production URL
# ✓ Generate new SECRET_KEY and CTRADER_ENCRYPTION_KEY (don't use dev keys!)
# ✓ Set CORS_ORIGINS to your production domain
# ✓ Set DEBUG=false
# ✓ Use PostgreSQL instead of SQLite for multi-user production
# ✓ Add all environment variables to Render dashboard
# ✓ Test OAuth flow with a small test account first
# ✓ Monitor token refresh logs for errors

# ===========================================
# Supported cTrader Brokers
# ===========================================
# Once connected, users can trade with:
# - FxPro (Forex, CFDs)
# - IronFX (Forex, Commodities)
# - Spotware (cTrader platform)
# - Any broker supporting cTrader OpenAPI
#
# Users connect their account via OAuth at:
# Settings → cTrader Connection → Connect Account
# They login on cTrader's site and authorize your app
# You NEVER see or store their broker password!