# .env - Environment Configuration for Docker Deployment
# Copy this to .env and fill in your API keys

# ===========================================
# NVIDIA NIM API (Required for AI features)
# ===========================================
Get your key from: https://build.nvidia.com/
NVIDIA_API_KEY=

# ===========================================
# Alpaca Trading (Required for execution)
# ===========================================
Get keys from: https://alpaca.markets/
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# ===========================================
# Binance (Optional - Crypto trading)
# ===========================================
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ===========================================
# Security (Generate random strings)
# ===========================================
# Generate with: openssl rand -hex 32
SECRET_KEY=
# Generate with: openssl rand -hex 16
API_AUTH_KEY=

# ===========================================
# Deployment
# ===========================================
# For local Docker: leave as is
# For production: set to your domain
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# ===========================================
# Kronos (4GB RAM optimized)
# ===========================================
KRONOS_MODEL=kronos-mini
KRONOS_FORECAST_HORIZON=50
KRONOS_BATCH_SIZE=3
KRONOS_MEMORY_THRESHOLD=85.0

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=json