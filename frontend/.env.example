# Jasper Trades Frontend Environment Variables

# Backend API URL (required)
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL for real-time updates (optional, defaults to API URL with ws:// protocol)
# For production: change to your backend URL (e.g., wss://jasper-backend.onrender.com)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Kronos forecast service URL is configured in backend/.env (KRONOS_SERVICE_URL).
# Frontend calls Kronos through the backend proxy at /api/v1/kronos/*,
# so no frontend-side Kronos URL is needed.

# Optional: Feature flags (non-sensitive only)
NEXT_PUBLIC_ENABLE_COPY_TRADING=true
NEXT_PUBLIC_ENABLE_BACKTESTING=true
NEXT_PUBLIC_ENABLE_PWA=true

# Optional: Analytics (disabled by default)
NEXT_PUBLIC_ENABLE_ANALYTICS=false