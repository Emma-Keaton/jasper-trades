# ═══════════════════════════════════════════════════════════════════════════════
# JASPER TRADES - BACKEND CONFIGURATION
# Copy this file to .env and configure for Render deployment
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# Application Settings
# ───────────────────────────────────────────────────────────────────────────────
APP_NAME="Jasper Trades"
APP_VERSION="1.0.0"
DEBUG=false

# ───────────────────────────────────────────────────────────────────────────────
# Server (Render uses $PORT environment variable automatically)
# ───────────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ───────────────────────────────────────────────────────────────────────────────
# Database (SQLite - file-based, no setup needed)
# ───────────────────────────────────────────────────────────────────────────────
DATABASE_URL="sqlite+aiosqlite:///./data/sqlite/jasper_trades.db"
DATA_DIR="./data"

# ───────────────────────────────────────────────────────────────────────────────
# NVIDIA NIM API - REQUIRED for AI features
# Get FREE API key: https://build.nvidia.com/
# ───────────────────────────────────────────────────────────────────────────────
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# ───────────────────────────────────────────────────────────────────────────────
# Model Routing (FREE tier verified 2026-06)
# All models below are FREE on NVIDIA NIM
# ───────────────────────────────────────────────────────────────────────────────
MODEL_FAST="meta/llama-3.2-3b-instruct"       # 3B, fast, FREE ✅
MODEL_BALANCED="meta/llama-3.1-8b-instruct"   # Mid-size, FREE ✅
MODEL_SMART="meta/llama-3.1-70b-instruct"     # 70B reasoning, FREE ✅
MODEL_DEEP="meta/llama-3.3-70b-instruct"      # 70B deepest FREE ✅
MODEL_ALTERNATIVE="mistralai/mixtral-8x7b-instruct-v0.1"  # Alternative perspective, FREE ✅

# ───────────────────────────────────────────────────────────────────────────────
# Binance (Optional - configure via Settings page)
# ───────────────────────────────────────────────────────────────────────────────
BINANCE_API_KEY=""
BINANCE_API_SECRET=""

# ───────────────────────────────────────────────────────────────────────────────
# Solana/Jupiter (Optional)
# ───────────────────────────────────────────────────────────────────────────────
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
JUPITER_API_KEY=""

# ───────────────────────────────────────────────────────────────────────────────
# Trove API - Nigerian/US Stocks (Optional - configure via Settings page)
# Get sandbox key: https://sandbox.api.trovefinance.com/
# ───────────────────────────────────────────────────────────────────────────────
TROVE_API_KEY=""
TROVE_BASE_URL="https://sandbox.api.trovefinance.com/v1"
TROVE_ENABLED=false
TROVE_SANDBOX=true

# Note: API keys should be set via Settings page (stored encrypted in database)
# Environment variables are fallback for local development only

# ───────────────────────────────────────────────────────────────────────────────
# Security - CHANGE THESE IN PRODUCTION!
# Generate random strings: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ───────────────────────────────────────────────────────────────────────────────
SECRET_KEY="change-this-in-production"
API_AUTH_KEY="jasper-auth-key-change-me"

# ───────────────────────────────────────────────────────────────────────────────
# CORS - Frontend URLs (comma-separated)
# Add your Render/Vercel URLs after deployment
# ───────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8080"

# ───────────────────────────────────────────────────────────────────────────────
# Agent Reach - Market Intelligence (Optional but Recommended)
# ───────────────────────────────────────────────────────────────────────────────
# Power your AI agents with real-time news and sentiment from Twitter, Reddit, etc.
#
# INSTALLATION (run locally first):
#   cd backend
#   pip install agent-reach
#   agent-reach install --env=auto
#
# CONFIGURE CHANNELS (requires browser with logged-in accounts):
#   agent-reach configure --channel twitter --from-browser chrome
#   agent-reach configure --channel reddit --from-browser chrome
#   agent-reach configure --channel xueqiu --from-browser chrome  # For CN stocks
#
# AVAILABLE CHANNELS:
#   twitter  - Real-time news & sentiment (requires browser login)
#   reddit   - WallStreetBets, r/stocks discussions (requires browser login)
#   xueqiu   - Chinese stock market sentiment (requires browser login)
#   v2ex     - Tech stock discussions (NO config needed - public)
#   polymarket - Prediction market insights (API-based)
#   rss      - Financial news RSS feeds (configure URLs below)
#
# RENDER DEPLOYMENT:
#   For Render, you have 2 options:
#   1. Use only public channels (v2ex, rss) - NO browser auth needed
#   2. Configure locally, then upload ~/.agent-reach/config.yaml to Render
#
#   For option 1, set:
#   AGENT_REACH_CHANNELS=v2ex,rss
#   AGENT_REACH_ENABLED=true
# ───────────────────────────────────────────────────────────────────────────────

# Enable market intelligence features
AGENT_REACH_ENABLED=true  # Set to true after configuring

# Channels to enable (comma-separated)
# Example: AGENT_REACH_CHANNELS=twitter,reddit,v2ex
# Or for Render (no browser auth): AGENT_REACH_CHANNELS=v2ex,rss
AGENT_REACH_CHANNELS=twitter,reddit,v2ex

# RSS feed URLs (comma-separated) - Comprehensive financial & crypto news
RSS_FEED_URLS=\
https://feeds.finance.com/markets,\
https://news.yahoo.com/rss/technology,\
https://feeds.feedburner.com/venturebeat/SZYF,\
https://www.cnbc.com/id/10001147/device/rss/rss.html,\
https://feeds.bloomberg.com/markets/news.rss,\
https://www.coindesk.com/arc/outboundfeeds/rss/,\
https://cointelegraph.com/rss,\
https://www.theblock.co/rss.xml,\
https://techcrunch.com/feed/,\
https://www.cnbc.com/id/10000311/device/rss/rss.html,\
https://nairametrics.com/feed/,\
https://www.caixinglobal.com/rss/economy.xml

# Agent Reach configuration file path
# After running configure-agent-reach.bat, this will be:
# AGENT_REACH_CONFIG_PATH=./agent_reach_config.yaml
# Or the default location: ~/.agent-reach/config.yaml
AGENT_REACH_CONFIG_PATH=./agent_reach_config.yaml

# Polling intervals (seconds) - SHORT intervals for real-time trading signals
NEWS_POLL_INTERVAL=15         # How often to fetch new news (15 seconds for trend trading)
SENTIMENT_CACHE_TTL=60        # Cache sentiment results for 1 minute (faster updates)
TREND_UPDATE_INTERVAL=30      # Update trending stocks every 30 seconds

# News analysis settings
MAX_NEWS_ARTICLES_PER_HOUR=200  # Rate limit for processing
SENTIMENT_ANALYSIS_ENABLED=true  # Enable AI-powered sentiment analysis
IMPACT_SCORING_ENABLED=true      # Enable impact scoring for news

# Alert thresholds for trading signals
NEWS_SENTIMENT_THRESHOLD=70    # Sentiment score (0-100) to trigger alerts
NEWS_VOLUME_SPIKE_MULTIPLIER=3.0  # Volume spike to detect trends
CROSS_PLATFORM_CONSENSUS_MIN=2     # Min platforms to agree on sentiment

# ───────────────────────────────────────────────────────────────────────────────
# Logging
# ───────────────────────────────────────────────────────────────────────────────
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# ───────────────────────────────────────────────────────────────────────────────
# Kronos AI Predictions (Optional - 3-model ensemble via Colab)
# Run kronos_colab.ipynb in Google Colab to get KRONOS_COLAB_URL
# ───────────────────────────────────────────────────────────────────────────────
KRONOS_MODEL="kronos-mini"
KRONOS_FORECAST_HORIZON=50
KRONOS_BATCH_SIZE=3
KRONOS_MEMORY_THRESHOLD=85.0
KRONOS_USE_CLOUD=false
HUGGINGFACE_API_TOKEN=""
KRONOS_COLAB_URL=""
KRONOS_COLAB_STRATEGY="cascade"
# cascade: Fast screening (mini→small→base) for 100s of pairs
# ensemble: Weighted average (20/30/50) for maximum accuracy
# context: Auto-select by data length (long→mini, short→base)
# mini/small/base: Single model only

# ───────────────────────────────────────────────────────────────────────────────
# MCP Server (AI Agent Integration - Optional)
# For Cursor, Claude Code, Codex to control Jasper Trades
# ───────────────────────────────────────────────────────────────────────────────
JASPER_BASE_URL="http://localhost:8000"
JASPER_AGENT_TOKEN=""

# ───────────────────────────────────────────────────────────────────────────────
# Copy Trading - Signal Sharing (Optional)
# Use GitHub Gists for free signal sync (no server needed)
# ───────────────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=""

# ───────────────────────────────────────────────────────────────────────────────
# Withdrawal service - Production API Keys
# Required for real blockchain transfers & withdrawals
# Get FREE API key: https://tatum.io
# ───────────────────────────────────────────────────────────────────────────────
TATUM_API_KEY=""
# Note: BINANCE_API_KEY and BINANCE_API_SECRET are already defined above

# ───────────────────────────────────────────────────────────────────────────────
# RENDER DEPLOYMENT QUICK START
#
# 1. Copy this file to .env in your Render environment variables
# 2. Generate secret keys:
#    SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
#    API_AUTH_KEY: python -c "import secrets; print('jasper_' + secrets.token_urlsafe(16))"
# 3. Add your NVIDIA API key from https://build.nvidia.com/
# 4. Update CORS_ORIGINS with your frontend URL after deploying to Vercel
# 5. Optional: Add Binance keys or configure via Settings page
#
# Render-specific settings (set directly in Render dashboard):
#   PYTHON_VERSION=3.11.0
#   PORT=10000 (Render sets this automatically)
# ───────────────────────────────────────────────────────────────────────────────