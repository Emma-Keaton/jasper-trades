# Application Settings
APP_NAME="Jasper Trades"
APP_VERSION="0.1.0"
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL="sqlite+aiosqlite:///./data/sqlite/jasper_trades.db"
DATA_DIR="./data"

# NVIDIA NIM API
# Get your API key from: https://build.nvidia.com/
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# Model Routing (FREE tier verified 2026-06)
# Working FREE models: nemotron-mini-4b, kimi-k2.6, nemotron-3-ultra-550b
MODEL_FAST="nvidia/nemotron-mini-4b-instruct"  # 4B, fast, FREE
MODEL_BALANCED="moonshotai/kimi-k2.6"  # Mid-size, FREE
MODEL_SMART="nvidia/nemotron-3-ultra-550b-a55b"  # 550B reasoning, FREE
MODEL_DEEP="nvidia/nemotron-3-ultra-550b-a55b"  # 550B is deepest FREE

# Alpaca (Paper Trading)
# Sign up: https://alpaca.markets/
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
ALPACA_PAPER=true  # true = paper trading, false = live trading

# Binance (optional)
BINANCE_API_KEY=""
BINANCE_API_SECRET=""

# Interactive Brokers (optional)
IBKR_HOST=""
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Solana/Jupiter (optional)
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
JUPITER_API_KEY=""

# Copy Trading - Signal Sharing
# Use GitHub Gists for free signal sync (no server needed)
GITHUB_TOKEN=""  # For private gists (optional, can use public)

# Security
SECRET_KEY="change-this-in-production"
API_AUTH_KEY="jasper-auth-key-change-me"

# CORS - Frontend URLs (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8080"

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# Kronos Integration (4GB RAM optimized)
# Leave KRONOS_MODEL as kronos-mini for 4GB systems
# Use kronos-mini-int8 for even smaller memory footprint
KRONOS_MODEL="kronos-mini"
KRONOS_FORECAST_HORIZON=50
KRONOS_BATCH_SIZE=3
KRONOS_MEMORY_THRESHOLD=85.0
KRONOS_USE_CLOUD=false
HUGGINGFACE_API_TOKEN=""  # Optional: For cloud fallback

# Kronos Colab Integration (3-model ensemble)
# Get Colab URL from ngrok after running kronos_colab.ipynb
KRONOS_COLAB_URL=""  # e.g., https://abc123.ngrok.io
KRONOS_COLAB_STRATEGY="cascade"  # cascade|ensemble|context|mini|small|base
# - cascade: Fast screening (mini→small→base) for 100s of pairs
# - ensemble: Weighted average (20/30/50) for maximum accuracy
# - context: Auto-select by data length (long→mini, short→base)
# - mini/small/base: Single model only

# MCP Server (AI Agent Integration)
# For Cursor, Claude Code, Codex to control Jasper Trades
JASPER_BASE_URL="http://localhost:8000"
JASPER_AGENT_TOKEN=""  # Generate via API or Settings page
# Note: Agent tokens are paper-only by default for safety
