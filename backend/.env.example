# ═══════════════════════════════════════════════════════════════════════════════
# JASPER TRADES - BACKEND CONFIGURATION
# Copy this file to .env and configure for Render deployment
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# Application Settings
# ───────────────────────────────────────────────────────────────────────────────
APP_NAME="Jasper Trades"
APP_VERSION="1.0.0"
DEBUG=false

# ENVIRONMENT gates behaviour that must not be on by accident:
#   * "production" enables the startup security check and disables /docs.
#     Left as "development" the docs endpoint stays publicly discoverable.
#   * Auto-payouts only start when ENVIRONMENT=production AND
#     AUTO_PAYOUTS_ENABLED=true. With either missing, payout settings save fine
#     and then nothing ever fires.
# Set this to "production" on any real deployment.
ENVIRONMENT=development

# ───────────────────────────────────────────────────────────────────────────────
# Server (Render uses $PORT environment variable automatically)
# ───────────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
# Render injects PORT itself; this value is only for local runs. Do not set PORT
# in the Render environment - fighting the platform breaks the health check.
PORT=8080

# ───────────────────────────────────────────────────────────────────────────────
# Database (SQLite - local dev default. Supabase/Postgres is the PERSISTENT option)
# ───────────────────────────────────────────────────────────────────────────────
DATABASE_URL="sqlite+aiosqlite:///./data/sqlite/jasper_trades.db"
DATA_DIR="./data"

# Supabase (Postgres) - RECOMMENDED for Render so data & sessions survive redeploys.
# The app auto-detects Postgres (asyncpg driver) from the DATABASE_URL scheme.
# 1. Create a project at https://supabase.com
# 2. Dashboard > Project Settings > Database > Connection string (pooler, port 6543)
#    -> copy the "Transaction" pooler string, set it as DATABASE_URL
#    Important: replace {db_password} with your DB password (URL-encoded).
#    The app's migrations run on startup and create the schema automatically;
#    you DO NOT need to run Supabase's SQL editor by hand.
# 3. Project Settings > Data API -> set SUPABASE_URL + SERVICE ROLE key
#    (only needed for realtime/auth/storage; the app mainly uses the DATABASE_URL).
# Example:
#   DATABASE_URL="postgresql://postgres.xxxx:YOURPASSWORD@aws-0-region.pooler.supabase.com:6543/postgres"
#   SUPABASE_URL="https://xxxx.supabase.co"
#   SUPABASE_ANON_KEY="eyJ..."
#   SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # server-only; never expose to frontend
# Leave DATABASE_URL as sqlite for local dev; asyncpg is auto-selected for postgres.

# Signal Sources - Telegram channel reading (Telethon)
# Get API ID + hash from https://my.telegram.org (API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=jasper

# Kronos time-series forecasting (confidence checks on signals)
# Kronos runs on Modal (E:\Projects\modal-kronos), NOT on Render: the model
# weights are far too large for a free Render service. Deploy it with
# `modal deploy modal_app.py` and use the endpoint it prints.
#
# KRONOS_API_KEY is REQUIRED. The service rejects unauthenticated requests, and
# without it every forecast fails and silently falls back to the local
# forecaster - which produces no sampled trajectories, so it can never be
# calibrated and no model will ever be promoted.
#
# On blank/missing/unreachable, the backend uses a built-in replacement
# forecaster (statsmodels -> deterministic trend) so signal confidence still gets
# a real UP/DOWN prediction. That fallback is degraded, not equivalent: it is
# never recorded in the prediction ledger.
KRONOS_SERVICE_URL=
KRONOS_API_KEY=

# Market data keys (stock prices)
# Get from https://finnhub.io (free) and https://www.alphavantage.com (free)
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# ───────────────────────────────────────────────────────────────────────────────
# LLM provider: GROQ is the only provider. See the top of this file for
# GROQ_API_KEY, GROQ_BASE_URL and the model routing block.
#
# GEMINI_API_KEY, GEMINI_BASE_URL, NVIDIA_API_KEY and NVIDIA_BASE_URL were
# removed. The app migrated to Groq and no longer references any of them, so
# setting them sent an operator to a provider that is never called.
# ───────────────────────────────────────────────────────────────────────────────

# ───────────────────────────────────────────────────────────────────────────────
# Model Routing (Gemini 2.5 Flash family - FREE tier)
# ───────────────────────────────────────────────────────────────────────────────
MODEL_FAST="gemini-2.5-flash-lite"        # fast, ~30 RPM / 1500 RPD FREE
MODEL_BALANCED="gemini-2.5-flash"          # ~10 RPM / 250 RPD FREE
MODEL_SMART="gemini-2.5-flash"
MODEL_DEEP="gemini-2.5-pro"                # ~5 RPM / 25 RPD FREE - use sparingly
MODEL_ALTERNATIVE="gemini-2.5-flash"

# ───────────────────────────────────────────────────────────────────────────────
# Binance (DEPRECATED for Nigeria - geo-blocked/restricted).
# Crypto market data now uses CCXT multi-CEX polling (geo-probe gated).
# Crypto LIVE trading uses a Nigeria-accessible exchange via CCXT (Bybit/OKX).
# ───────────────────────────────────────────────────────────────────────────────
BINANCE_API_KEY=""
BINANCE_API_SECRET=""

# ───────────────────────────────────────────────────────────────────────────────
# CCXT market data + live crypto (Nigeria-accessible CEX set, geo-probe gated)
# Comma-separated; the geo-probe prunes to whatever works from the Render region.
# ───────────────────────────────────────────────────────────────────────────────
CCXT_EXCHANGES="bybit,okx,kucoin,gate,htx,bingx,bitget,mexc,kraken,coinbase,bitfinex,bitstamp"
CCXT_BINANCE_OPT_IN=false

# ───────────────────────────────────────────────────────────────────────────────
# Solana / Jupiter (Optional)
# ───────────────────────────────────────────────────────────────────────────────
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
JUPITER_API_KEY=""
# Public Jupiter and DexScreener endpoints. Overridable for paid tiers or to pin
# a specific host; the defaults need no key.
JUPITER_LITE_API="https://lite-api.jup.ag"
DEXSCREENER_API="https://api.dexscreener.com"
# CoinMarketCap key for the CMC market-data provider. Optional: without it that
# provider is skipped and the free providers are used instead.
CMC_API_KEY=""

# ───────────────────────────────────────────────────────────────────────────────
# Trove API - Nigerian/US Stocks (Optional)
# Get sandbox key: https://sandbox.api.trovefinance.com/
#
# TROVE_API_KEY, TROVE_BASE_URL, TROVE_ENABLED and TROVE_SANDBOX were removed:
# none of them is a Settings field and nothing read them, so setting them had no
# effect. Trove credentials are configured in the Settings UI and stored
# encrypted in `device_settings`. See tests/test_env_example.py.
# ───────────────────────────────────────────────────────────────────────────────

# Note: API keys should be set via Settings page (stored encrypted in database)
# Environment variables are fallback for local development only

# ───────────────────────────────────────────────────────────────────────────────
# Security - CHANGE THESE IN PRODUCTION!
# Generate random strings: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ───────────────────────────────────────────────────────────────────────────────
SECRET_KEY="change-this-in-production"
API_AUTH_KEY="jasper-auth-key-change-me"

# ───────────────────────────────────────────────────────────────────────────────
# CORS - Frontend URLs (comma-separated)
# Add your Render/Vercel URLs after deployment
# ───────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8080"

# ───────────────────────────────────────────────────────────────────────────────
# Agent Reach - Market Intelligence (Optional but Recommended)
# ───────────────────────────────────────────────────────────────────────────────
# Power your AI agents with real-time news and sentiment from Twitter, Reddit, etc.
#
# INSTALLATION (run locally first):
#   cd backend
#   pip install agent-reach
#   agent-reach install --env=auto
#
# CONFIGURE CHANNELS (requires browser with logged-in accounts):
#   agent-reach configure --channel twitter --from-browser chrome
#   agent-reach configure --channel reddit --from-browser chrome
#   agent-reach configure --channel xueqiu --from-browser chrome  # For CN stocks
#
# AVAILABLE CHANNELS:
#   twitter  - Real-time news & sentiment (requires browser login)
#   reddit   - WallStreetBets, r/stocks discussions (requires browser login)
#   xueqiu   - Chinese stock market sentiment (requires browser login)
#   v2ex     - Tech stock discussions (NO config needed - public)
#   polymarket - Prediction market insights (API-based)
#   rss      - Financial news RSS feeds (configure URLs below)
#
# MARKET INTELLIGENCE (legacy agent_reach shim - real scraping moved to signal_sources)
# Telegram and Reddit polling is handled by the signal_sources scrapers
# (app/services/signal_sources), polled every 2 minutes by the scheduler.
# AGENT_REACH_CHANNELS is kept for backward compatibility only.
AGENT_REACH_ENABLED=true
AGENT_REACH_CHANNELS=telegram,reddit

# RSS_FEED_URLS was removed: nothing read it. RSS scraping lives in
# app/services/signal_sources, which uses its own configured sources. The
# NEWSAPI_KEY / CRYPTOPANIC_KEY above are what that path actually uses.

# Agent Reach configuration file path (unused by the signal_sources shim)
# AGENT_REACH_CONFIG_PATH=./agent_reach_config.yaml
# AGENT_REACH_CONFIG_PATH=./agent_reach_config.yaml

# Polling intervals (seconds) - SHORT intervals for real-time trading signals
NEWS_POLL_INTERVAL=15         # How often to fetch new news (15 seconds for trend trading)
SENTIMENT_CACHE_TTL=60        # Cache sentiment results for 1 minute (faster updates)

# News analysis settings
SENTIMENT_ANALYSIS_ENABLED=true  # Enable AI-powered sentiment analysis

# Removed because nothing read them; setting them had no effect, which is worse
# than not documenting them. Add the field to `Settings` in app/config.py first.
# tests/test_env_example.py holds this file to that:
#   TREND_UPDATE_INTERVAL, MAX_NEWS_ARTICLES_PER_HOUR, IMPACT_SCORING_ENABLED,
#   NEWS_SENTIMENT_THRESHOLD, NEWS_VOLUME_SPIKE_MULTIPLIER,
#   CROSS_PLATFORM_CONSENSUS_MIN

# ───────────────────────────────────────────────────────────────────────────────
# Logging
# ───────────────────────────────────────────────────────────────────────────────
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# ───────────────────────────────────────────────────────────────────────────────
# Optional third-party dependencies (statsmodels, yfinance).
#
# The app installs absent packages from here AFTER startup, once the process is
# under OPTIONAL_DEPS_MAX_RSS_MB. Turn it off if your build environment can
# declare these in requirements.txt instead - on Render's free tier the container
# is destroyed on every idle sleep, so a runtime install re-downloads on every
# wake, while a build-time install happens once.
#
# Absence never blocks boot and never fails readiness. GET /api/v1/health reports
# what is missing under "optional_dependencies_absent".
#
# This does NOT apply to pandas, which is a hard requirement: it is imported
# unguarded by 457 files in app/alpha_zoo and elsewhere, so it is declared in
# requirements.txt and must stay there.
# ───────────────────────────────────────────────────────────────────────────────
OPTIONAL_DEPS_AUTO_INSTALL=true
# RSS ceiling in MB that must be clear before the install starts. Boot peaks near
# 190-250 MB on Render free (512 MB total); 320 leaves room for one pip
# subprocess without risking an OOM kill mid-extraction.
OPTIONAL_DEPS_MAX_RSS_MB=320.0
# Stop waiting for headroom after this long and install anyway.
OPTIONAL_DEPS_MEMORY_TIMEOUT_SECONDS=300.0
# Quiet period after startup before the first memory check, so the install does not
# compete with boot and warm-up.
OPTIONAL_DEPS_SETTLE_SECONDS=20.0

# ───────────────────────────────────────────────────────────────────────────────
# Kronos predictions - runs on Modal (E:\Projects\modal-kronos), NOT Render.
# The weights are far too large for a free Render service.
# KRONOS_SERVICE_URL and KRONOS_API_KEY are documented in full at line 48.
# ───────────────────────────────────────────────────────────────────────────────
KRONOS_MODEL="kronos-mini"
KRONOS_FORECAST_HORIZON=50
KRONOS_SAMPLES=10          # trajectories per forecast; <2 is refused by the ledger
HUGGINGFACE_API_TOKEN=""

# ───────────────────────────────────────────────────────────────────────────────
# MCP Server (AI Agent Integration)
# JASPER_BASE_URL and JASPER_AGENT_TOKEN were removed: no MCP server ships in
# this repository and nothing read them. Add them to `Settings` in
# app/config.py and wire the server before documenting them again.
# ───────────────────────────────────────────────────────────────────────────────

# ───────────────────────────────────────────────────────────────────────────────
# Copy Trading - Signal Sharing (Optional)
# Use GitHub Gists for free signal sync (no server needed)
# ───────────────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=""

# ───────────────────────────────────────────────────────────────────────────────
# WalletConnect (EVM wallet connection in Settings)
# Create a project at https://cloud.walletconnect.com and paste the Project ID here.
# The backend exposes it via GET /api/v1/settings/public; it is never built into
# the frontend. Leave blank to disable WalletConnect QR (MetaMask injected still works).
# ───────────────────────────────────────────────────────────────────────────────
WALLETCONNECT_PROJECT_ID=""

# ───────────────────────────────────────────────────────────────────────────────
# Payouts - Direct on-chain USDT (no Tatum, no API key)
#
# TATUM_API_KEY was removed. The old Tatum integration could not work: it posted
# `fromAddress: None` assuming Tatum held a custody wallet, and Tatum has no
# custody wallet for its transfer endpoint. It also cost mainnet gas from our own
# balance, so it saved nothing.
#
# Payouts are now signed locally and broadcast to the chain. The hot-wallet
# private key is configured in the Settings UI (Auto-Payout section) and stored
# encrypted in `device_settings.payout_wallet_keys`. There is deliberately no
# environment variable for it, so no key ever lands in a file or a deploy log.
# See app/services/payout_rail.py.
# ───────────────────────────────────────────────────────────────────────────────
# Note: BINANCE_API_KEY and BINANCE_API_SECRET are already defined above

# ───────────────────────────────────────────────────────────────────────────────
# Trading mode and payouts
# ───────────────────────────────────────────────────────────────────────────────
# Universal paper trading is the safe default. Per-portfolio `is_paper` overrides
# it. There is no `_PAPER` variable - the previous example file advertised one and
# it switched nothing.
UNIVERSAL_PAPER_TRADING=true
UNIVERSAL_PAPER_CAPITAL=10000.0
UNIVERSAL_PAPER_CURRENCY=USD

# Auto-payouts require BOTH of these. With either missing the scheduler does not
# start, payout settings save without error, and nothing ever fires. The only
# symptom is a "Auto-payout scheduler not started" log line.
AUTO_PAYOUTS_ENABLED=false

# Alpha-factor sweep. Trades only for devices whose agents have been started
# (DeviceSettings.preferences.agents_started).
FACTOR_TRADING_ENABLED=true
FACTOR_TIMEFRAME="1h"

# ───────────────────────────────────────────────────────────────────────────────
# Telegram (notifications + two-way chat)
# ───────────────────────────────────────────────────────────────────────────────
# Without a token the bot is disabled at startup; alerts are silently absent.
TELEGRAM_BOT_TOKEN=""
# Required for webhook request verification when running behind a tunnel.
TELEGRAM_WEBHOOK_SECRET=""

# ───────────────────────────────────────────────────────────────────────────────
# RENDER DEPLOYMENT QUICK START
#
# 1. Copy this file to .env in your Render environment variables
# 2. Generate secret keys:
#    SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
#    API_AUTH_KEY: python -c "import secrets; print('jasper_' + secrets.token_urlsafe(16))"
# 3. Set ENVIRONMENT=production and DEBUG=false
# 4. Point DATABASE_URL at Supabase Postgres - the free tier wipes its disk, which
#    would reset the Kronos prediction ledger and all learned thresholds
# 5. Update CORS_ORIGINS with your frontend URL after deploying to Vercel
# 6. Set TELEGRAM_BOT_TOKEN if you want trade alerts
#
# Render-specific (set in the Render dashboard):
#   PYTHON_VERSION=3.11.0
#   PORT is injected by Render - do not set it
# ───────────────────────────────────────────────────────────────────────────────