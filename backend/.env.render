# ═══════════════════════════════════════════════════════════════════════════════
# JASPER TRADES - RENDER ENVIRONMENT VARIABLES
# Copy ALL of this directly into Render dashboard → Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════

PYTHON_VERSION=3.11.0
PORT=8080
DEBUG=false
APP_NAME="Jasper Trades"
APP_VERSION="1.0.0"

DATABASE_URL="sqlite+aiosqlite:///./data/sqlite/jasper_trades.db"
DATA_DIR="./data"

NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

MODEL_FAST="nvidia/nemotron-mini-4b-instruct"
MODEL_BALANCED="moonshotai/kimi-k2.6"
MODEL_SMART="nvidia/nemotron-3-ultra-550b-a55b"
MODEL_DEEP="nvidia/nemotron-3-ultra-550b-a55b"

BINANCE_API_KEY=""
BINANCE_API_SECRET=""

TATUM_API_KEY=""

# Trove API - Nigerian/US Stocks (Optional - configure via Settings page after deployment)
TROVE_API_KEY=""
TROVE_BASE_URL="https://sandbox.api.trovefinance.com/v1"
TROVE_ENABLED=false
TROVE_SANDBOX=true

# cTrader OAuth Settings (Optional - configure via Settings page after deployment)
CTRADER_CLIENT_ID=""
CTRADER_CLIENT_SECRET=""
CTRADER_REDIRECT_URI="https://jasper-trades.onrender.com/api/v1/brokers/callback"

SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
JUPITER_API_KEY=""

SECRET_KEY="change-this-in-production"
API_AUTH_KEY="jasper-auth-key-change-me"

CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8080,https://jasper-trades.vercel.app"

# Frontend WebSocket URL (for Vercel deployment)
NEXT_PUBLIC_WS_URL="wss://jasper-trades.onrender.com"
NEXT_PUBLIC_API_URL="https://jasper-trades.onrender.com"

LOG_LEVEL="INFO"
LOG_FORMAT="json"

KRONOS_MODEL="kronos-mini"
KRONOS_FORECAST_HORIZON=50
KRONOS_BATCH_SIZE=3
KRONOS_MEMORY_THRESHOLD=85.0
KRONOS_USE_CLOUD=false
HUGGINGFACE_API_TOKEN=""
KRONOS_COLAB_URL=""
KRONOS_COLAB_STRATEGY="cascade"

JASPER_BASE_URL="http://localhost:8000"
JASPER_AGENT_TOKEN=""

GITHUB_TOKEN=""