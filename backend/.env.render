# ═══════════════════════════════════════════════════════════════════════════════
# JASPER TRADES - RENDER ENVIRONMENT VARIABLES
# Copy ALL of this directly into Render dashboard → Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# Application & Server
# ───────────────────────────────────────────────────────────────────────────────
PYTHON_VERSION=3.11.0
PORT=8080
DEBUG=false
APP_NAME="Jasper Trades"
APP_VERSION="1.0.0"
ENVIRONMENT=production

# ───────────────────────────────────────────────────────────────────────────────
# Database
# ───────────────────────────────────────────────────────────────────────────────
DATABASE_URL="sqlite+aiosqlite:///./data/sqlite/jasper_trades.db"
DATA_DIR="./data"

# ───────────────────────────────────────────────────────────────────────────────
# LLM / AI (Required for AI features)
# ───────────────────────────────────────────────────────────────────────────────
# PRIMARY LLM - Gemini 2.5 Flash. Comma-separated keys for rotation (separate accounts).
GEMINI_API_KEYS=""

# FALLBACK - NVIDIA NIM, used automatically only if Gemini is down/unconfigured.
# Per-task NVIDIA model is fixed in backend/app/nvidia_nim.py.
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# Gemini model tiers (only used when Gemini is the provider)
MODEL_FAST="gemini-2.5-flash-lite"
MODEL_SMART="gemini-2.5-flash"
MODEL_DEEP="gemini-2.5-pro"

# ───────────────────────────────────────────────────────────────────────────────
# Broker APIs (Set via Settings page or here)
# ───────────────────────────────────────────────────────────────────────────────
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
TATUM_API_KEY=""
TROVE_API_KEY=""
TROVE_BASE_URL="https://sandbox.api.trovefinance.com/v1"
TROVE_ENABLED=false
TROVE_SANDBOX=true

# ───────────────────────────────────────────────────────────────────────────────
# WalletConnect (EVM wallet connection in Settings)
# Create a project at https://cloud.walletconnect.com and paste the Project ID here.
# The backend exposes it via GET /api/v1/settings/public; it is never built into
# the frontend. Leave blank to disable WalletConnect QR (MetaMask injected still works).
# ───────────────────────────────────────────────────────────────────────────────
WALLETCONNECT_PROJECT_ID=""

# ───────────────────────────────────────────────────────────────────────────────
# cTrader OAuth
# ───────────────────────────────────────────────────────────────────────────────
CTRADER_CLIENT_ID=""
CTRADER_CLIENT_SECRET=""
CTRADER_REDIRECT_URI="https://jasper-trades.onrender.com/api/v1/brokers/callback"
CTRADER_ENCRYPTION_KEY=""
CTRADER_SANDBOX=true
CTRADER_BROKER_ENABLED=true

# ───────────────────────────────────────────────────────────────────────────────
# Solana/Jupiter
# ───────────────────────────────────────────────────────────────────────────────
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
JUPITER_API_KEY=""

# ───────────────────────────────────────────────────────────────────────────────
# SECURITY - Generate these with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ───────────────────────────────────────────────────────────────────────────────
SECRET_KEY=""
API_AUTH_KEY=""

# ───────────────────────────────────────────────────────────────────────────────
# CORS & URLs (Update with your actual deployment URLs)
# ───────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS="https://jasper-trades.vercel.app,https://jasper-trades.onrender.com,http://localhost:3000"
NEXT_PUBLIC_WS_URL="wss://jasper-trades.onrender.com"
NEXT_PUBLIC_API_URL="https://jasper-trades.onrender.com"

# ───────────────────────────────────────────────────────────────────────────────
# Telegram Bot (Required for notifications)
# ───────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""

# ───────────────────────────────────────────────────────────────────────────────
# Kronos AI (Remote Service - Render Deployment)
# ───────────────────────────────────────────────────────────────────────────────
# After deploying kronos-service to Render, set this to your Kronos service URL
# Example: KRONOS_SERVICE_URL="https://jasper-trades-kronos.onrender.com"
KRONOS_SERVICE_URL=""

# Legacy local Kronos settings (deprecated when using remote service)
KRONOS_MODEL="kronos-mini"
KRONOS_FORECAST_HORIZON=50
KRONOS_BATCH_SIZE=3
KRONOS_MEMORY_THRESHOLD=85.0
KRONOS_USE_CLOUD=false
HUGGINGFACE_API_TOKEN=""

# Legacy Colab settings (deprecated)
KRONOS_COLAB_URL=""
KRONOS_COLAB_STRATEGY="cascade"

# ───────────────────────────────────────────────────────────────────────────────
# Agent Reach - Market Intelligence (Optional but Recommended)
# ───────────────────────────────────────────────────────────────────────────────
# IMPORTANT: Agent Reach requires browser-based authentication for Twitter/Reddit
# For Render deployment, you have 2 options:
# 
# Option 1: Use only public channels (V2EX, RSS) - NO configuration needed
# Option 2: Configure locally first, then deploy config file to Render
# 
# Setup (run locally first):
#   cd backend
#   pip install agent-reach
#   agent-reach install --env=auto
#   agent-reach configure --channel twitter --from-browser chrome
#   agent-reach configure --channel reddit --from-browser chrome
# 
# Then upload ~/.agent-reach/config.yaml to Render as an environment variable
# Or use only public channels that don't require authentication

# Enable market intelligence
AGENT_REACH_ENABLED=true  # Set to true after configuring channels

# Channels: twitter,reddit,xueqiu,v2ex,polymarket,rss
# For Render without browser auth, use: v2ex,rss only
# For local dev with browser auth: twitter,reddit,v2ex
AGENT_REACH_CHANNELS=twitter,reddit,v2ex

# Polling intervals (seconds) - SHORT intervals for real-time trading signals
NEWS_POLL_INTERVAL=15       # How often to fetch new news (15 seconds for trend trading)
SENTIMENT_CACHE_TTL=60      # Cache sentiment results for 1 minute (faster updates)
TREND_UPDATE_INTERVAL=30    # Update trending stocks every 30 seconds

# News analysis settings
MAX_NEWS_ARTICLES_PER_HOUR=100
SENTIMENT_ANALYSIS_ENABLED=true
IMPACT_SCORING_ENABLED=true

# Alert thresholds
NEWS_SENTIMENT_THRESHOLD=70
NEWS_VOLUME_SPIKE_MULTIPLIER=3.0
CROSS_PLATFORM_CONSENSUS_MIN=2

# ───────────────────────────────────────────────────────────────────────────────
# Logging
# ───────────────────────────────────────────────────────────────────────────────
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# ───────────────────────────────────────────────────────────────────────────────
# MCP Server (Optional - AI Agent Integration)
# ───────────────────────────────────────────────────────────────────────────────
JASPER_BASE_URL="http://localhost:8000"
JASPER_AGENT_TOKEN=""

# ───────────────────────────────────────────────────────────────────────────────
# Copy Trading (Optional)
# ───────────────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=""

# ───────────────────────────────────────────────────────────────────────────────
# Rate Limiting (Production Security)
# ───────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=100

# ───────────────────────────────────────────────────────────────────────────────
# Security Headers
# ───────────────────────────────────────────────────────────────────────────────
SECURITY_HSTS_ENABLED=true
SECURE_COOKIES=true