# =============================================================================
# Kronos Forecast Service — Local + Cloud Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# --- Service URL (required) ---------------------------------------------------
# Local development:  http://localhost:8001
# Cloud (Modal):      https://jasper-kronos--web-xxx.modal.run
KRONOS_SERVICE_URL=http://localhost:8001

# --- API Key (required) -------------------------------------------------------
# Shared secret sent as the X-API-Key header. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
KRONOS_API_KEY=

# --- Model variant (optional) -------------------------------------------------
# NeoQuasar/Kronos-mini  = 4.1M params, ~16 MB weights, fits 2GB RAM (default)
# NeoQuasar/Kronos-small = 24.7M params, ~100 MB weights, ~4x slower
KRONOS_MODEL=NeoQuasar/Kronos-mini

# --- Rate limiting (optional) -------------------------------------------------
KRONOS_RATE_PER_SECOND=16
KRONOS_RATE_BURST=900
KRONOS_RATE_MAX_WEIGHT=14

# --- Hugging Face (optional) --------------------------------------------------
# Only needed if you want to use the Hugging Face Inference API as a fallback.
HUGGINGFACE_API_TOKEN=

# --- Local service port (optional) --------------------------------------------
# Port for `python start_kronos.py` (default 8001).
KRONOS_LOCAL_PORT=8001

# --- Backend connection -------------------------------------------------------
# The jasper-trades backend points at this URL for predictions.
# Set KRONOS_SERVICE_URL in backend/.env to this same value.
BACKEND_API_URL=http://localhost:8000